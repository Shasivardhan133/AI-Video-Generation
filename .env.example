# Django settings consumed by backend/config/settings.py
# Generate your own secret key and put it here before running with DJANGO_DEBUG=False, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# The placeholder below is publicly known: Django refuses to start with it unless DJANGO_DEBUG=True.
DJANGO_SECRET_KEY=replace-with-a-local-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# True only behind an HTTPS reverse proxy that overwrites X-Forwarded-Proto on every
# request (see backend/README.md, Production deployment). Leave False otherwise.
DJANGO_BEHIND_HTTPS_PROXY=False

# MySQL settings consumed by backend/config/settings.py
MYSQL_DATABASE=ai_video_generator
MYSQL_USER=replace-with-local-user
MYSQL_PASSWORD=replace-with-local-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# AI service
# mock (default): renders a local FFmpeg test pattern, not an AI video; needs FFmpeg.
# remote: HTTP client for the protected Colab service (not yet integrated); needs the URL and key below.
AI_SERVICE_MODE=mock
AI_SERVICE_BASE_URL=https://replace-with-protected-colab-endpoint
AI_SERVICE_API_KEY=replace-with-local-service-key
# Remote mode only, whole seconds: per-request timeout, status polling interval, and the overall
# deadline for one generation (submission + polling + video download).
AI_SERVICE_TIMEOUT=30
AI_SERVICE_POLL_INTERVAL=10
AI_SERVICE_MAX_WAIT=1800
# Largest video accepted from the remote service, in bytes (default 104857600 = 100 MiB).
AI_SERVICE_MAX_VIDEO_BYTES=104857600

# Media
MEDIA_ROOT=media
MEDIA_URL=/media/

# Generation worker
# True: `manage.py runserver` also runs one worker thread. False: run `manage.py run_generation_worker` separately.
RUN_WORKER_IN_PROCESS=True
# Seconds a job may wait in the queue before it fails with `queue_timeout` (default 1800 = 30 minutes).
# Expiry needs a running worker, or `python manage.py expire_stale_jobs` run from a scheduler.
GENERATION_QUEUE_TIMEOUT_SECONDS=1800
