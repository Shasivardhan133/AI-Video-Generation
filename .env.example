# Django settings consumed by backend/config/settings.py
DJANGO_SECRET_KEY=replace-with-a-local-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL settings consumed by backend/config/settings.py
MYSQL_DATABASE=ai_video_generator
MYSQL_USER=replace-with-local-user
MYSQL_PASSWORD=replace-with-local-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# AI service
AI_SERVICE_BASE_URL=https://replace-with-protected-colab-endpoint
AI_SERVICE_API_KEY=replace-with-local-service-key

# Media
MEDIA_ROOT=media
MEDIA_URL=/media/
